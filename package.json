{
  "name": "stromfenster",
  "private": true,
  "description": "Shows when electricity in Germany is cheap and clean",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --test-scheduled --var IMPORT_ALL_SERIES:true",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p worker/tsconfig.json",
    "test": "vitest run --project unit --project nuxt",
    "test:worker": "vitest run --project worker",
    "test:site": "vitest run --project site",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:worker && pnpm build && pnpm test:site",
    "db:migrate": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0"
  }
}
