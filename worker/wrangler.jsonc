// The data pipeline Worker: Cron import, D1 and the JSON API.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stromfenster",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      // No id: Wrangler finds the database by its name.
      "database_name": "stromfenster",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Runs the import: every minute, one series per run (worker/src/schedule.ts).
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
